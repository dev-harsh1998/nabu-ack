# Xiaomi Pad 5 (nabu) / SM8150 no-module Android defconfig fragment
# Merge on top of arch/arm64/configs/gki_defconfig. All drivers are built-in.

CONFIG_MODULES=n
CONFIG_WERROR=y
CONFIG_ANDROID_BINDER_IPC_RUST=n
CONFIG_VIRTUALIZATION=n
CONFIG_KVM=n
CONFIG_PTDUMP_STAGE2_DEBUGFS=n
CONFIG_GUNYAH=n
CONFIG_GUNYAH_IRQFD=n
CONFIG_GUNYAH_IOEVENTFD=n
CONFIG_GUNYAH_QCOM_TRUSTED_VM=n
CONFIG_ARM_PKVM_GUEST=n
CONFIG_PKVM_PVIOMMU=n
CONFIG_VFIO_PKVM_IOMMU=n
CONFIG_ARM_SMMU_V3=y
CONFIG_ARM_SMMU_V3_SVA=y


# Required platform dependencies for the vendor fragment
CONFIG_COMMON_CLK_QCOM=y
CONFIG_QCOM_COMMAND_DB=y
CONFIG_NVMEM_QCOM_QFPROM=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_SERIAL_DEV_BUS=y
CONFIG_RPMSG=y
CONFIG_RPMSG_QCOM_GLINK=y
CONFIG_RPMSG_QCOM_GLINK_SMEM=y
CONFIG_RPMSG_QCOM_SMD=y


# Boot essentials for Android / device-tree overlays
CONFIG_OF_OVERLAY=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_QCOM_WDT=y
CONFIG_QCOM_ICC_BWMON=y
CONFIG_QCOM_PBS=y

# SoC / interconnect / clocks
CONFIG_QCOM_LLCC=y
CONFIG_QCOM_OCMEM=y
CONFIG_QCOM_RPMH=y
