CONFIG_SND_SOC_QDSP6_ADM=y
CONFIG_SND_SOC_QDSP6_APM=y
CONFIG_SND_SOC_QDSP6_APM_DAI=y
CONFIG_SND_SOC_QDSP6_APM_LPASS_DAI=y
CONFIG_SND_SOC_QDSP6_PRM=y
CONFIG_SND_SOC_QDSP6_PRM_LPASS_CLOCKS=y
CONFIG_SND_SOC_SM8150=y
CONFIG_SND_SOC_WCD934X=y
CONFIG_SND_SOC_WCD_COMMON=y
CONFIG_SND_SOC_WCD_MBHC=y
CONFIG_SND_SOC_WCD_CLASSH=y
CONFIG_SND_SOC_CS35L41=y
CONFIG_SND_SOC_CS35L41_I2C=y
CONFIG_SND_SOC_CS35L41_LIB=y
CONFIG_SND_SOC_I2C_AND_SPI=y
CONFIG_SND_SOC_COMPRESS=y

# Camera / video
CONFIG_VIDEO_QCOM_CAMSS=y
CONFIG_VIDEO_OV13B10=y
CONFIG_VIDEO_OV8856=y
CONFIG_VIDEO_CN3927=y
CONFIG_VIDEO_QCOM_IRIS=y

# Power / charging / LEDs
CONFIG_POWER_SUPPLY=y
CONFIG_QCOM_BMS=y
CONFIG_QCOM_BMS_LN8000=y
CONFIG_QCOM_BMS_DS28E16=y
CONFIG_CHARGER_IDTP9418=y
CONFIG_LEDS_CLASS_FLASH=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_LEDS_QCOM_FLASH=y
CONFIG_LEDS_QCOM_LPG=y
CONFIG_LEDS_TRIGGERS=y
CONFIG_LEDS_TRIGGER_PATTERN=y
CONFIG_LEDS_TRIGGER_ONESHOT=y
CONFIG_LEDS_TRIGGER_BACKLIGHT=y
CONFIG_LEDS_TRIGGER_ACTIVITY=y

# Wireless / sensors transport
CONFIG_WLAN_VENDOR_ATH=y
CONFIG_ATH10K=y
CONFIG_ATH10K_SNOC=y
CONFIG_ATH10K_CE=y
CONFIG_BT_HCIUART=y
CONFIG_BT_HCIUART_QCA=y
CONFIG_BT_HCIUART_SERDEV=y
CONFIG_BT_HCIUART_H4=y
CONFIG_QRTR=y
CONFIG_QRTR_SMD=y
# Built-in zram for Android
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_BACKEND_LZO=y
CONFIG_ZRAM_MULTI_COMP=y
