CONFIG_SERIAL_QCOM_GENI_UART_PORTS=8
CONFIG_I2C_QCOM_GENI=y
CONFIG_I2C_QCOM_CCI=y
CONFIG_SPI_QCOM_GENI=y
CONFIG_SLIMBUS=y
CONFIG_SLIM_QCOM_NGD_CTRL=y
